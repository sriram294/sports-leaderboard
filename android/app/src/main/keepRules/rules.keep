# Retrofit creates this interface at runtime. Its built-in consumer rules keep
# annotated methods, but retaining this small API interface avoids release-only
# optimization changing the match submission contract.
-keep interface com.org.playboard.data.remote.PlayboardApi { *; }

# Match recording is the only request path that uses this nested DTO graph.
# Keep the DTOs and generated kotlinx.serialization serializers together so R8
# cannot optimize away metadata or accessors needed to encode the request body.
-keep class com.org.playboard.data.remote.dto.RecordMatchRequestDto { *; }
-keep class com.org.playboard.data.remote.dto.TeamInputDto { *; }
-keep class com.org.playboard.data.remote.dto.SetInputDto { *; }
-keep class com.org.playboard.data.remote.dto.RecordMatchRequestDto$$serializer { *; }
-keep class com.org.playboard.data.remote.dto.TeamInputDto$$serializer { *; }
-keep class com.org.playboard.data.remote.dto.SetInputDto$$serializer { *; }
